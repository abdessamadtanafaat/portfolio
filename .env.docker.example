# Copy to .env.docker and fill values. Never commit .env.docker.
#   cp .env.docker.example .env.docker

# --- Public URL (must match how you open the site) ---
# Browser on Mac → container:
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
HOST_PORT=3000

# --- Auth (required) ---
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# --- Database (required) ---
# Recommended for Docker: Turso remote
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token
# Local file inside the container volume (alternative):
# TURSO_DATABASE_URL=file:/app/data/local.db
# TURSO_AUTH_TOKEN=

# --- Admin (used by seed on the host, not by the running container) ---
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Abdessamad Tanafaat

# --- Contact / email (optional) ---
RESEND_API_KEY=
CONTACT_EMAIL=tanafaatabdessamad@gmail.com
EMAIL_FROM=

# --- Optional ---
BLOB_READ_WRITE_TOKEN=
REVALIDATION_SECRET=
