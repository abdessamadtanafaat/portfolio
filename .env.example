# Turso (libSQL) Database
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Admin User (created on first seed)
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Abdessamad Tanafaat

# Contact Email (Resend)
# In development, emails are sent from onboarding@resend.dev automatically.
# In production, emails are sent from noreply@yourdomain.com.
# Set EMAIL_FROM only when your domain is verified in Resend.
RESEND_API_KEY=re_your_api_key
CONTACT_EMAIL=tanafaatabdessamad@gmail.com
EMAIL_FROM="Portfolio Contact <noreply@yourdomain.com>"

# Vercel Blob (optional — for image uploads)
BLOB_READ_WRITE_TOKEN=

# Revalidation (optional — for external webhooks)
REVALIDATION_SECRET=
